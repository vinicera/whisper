    },
    "enunciado_latex": {
      "default": "",
      "title": "Enunciado Latex",
      "type": "string"
    },
    "enunciado_falado": {
      "default": "",
      "title": "Enunciado Falado",
      "type": "string"
    },
    "tipo": {
      "default": "outro",
      "enum": [
        "derivada",
        "integral_indefinida",
        "integral_definida",
        "limite",
        "serie",
        "edo",
        "equacao",
        "outro"
      ],
      "title": "Tipo",
      "type": "string"
    },
    "plano_falado": {
