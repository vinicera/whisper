# Copie para .env e preencha. NUNCA versione o .env.

# Provedor de IA: "gemini" (real) ou "fake" (resposta fixa, para testes sem custo)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo usado pelo servidor (pode ser maior que o do Modo Direto do app)
GEMINI_MODEL=gemini-3.8-flash

# Token exigido no header "Authorization: Bearer <token>" (gere um aleatorio longo)
BRIDGE_TOKEN=

# Rede
HOST=0.0.0.0
PORT=8787

# Verificacao SymPy
VERIFY_TIMEOUT_SECONDS=8
MAX_RETRIES_ON_VERIFY_FAIL=1

# Historico (SQLite)
HISTORY_DB=data/history.db
